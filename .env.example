# Copie para .env e preencha. O .env NÃO vai para o Git.

# Client ID de um app registrado em https://myanimelist.net/apiconfig
# (App Type: other · Purpose: hobbyist · Commercial: non-commercial)
MAL_CLIENT_ID=

# Seu usuário no MAL (a lista precisa estar pública) — alimenta "Meu perfil" e as recomendações
MAL_USERNAME=

# Ritmo das requisições (requisições por segundo). Seja educado com as APIs.
MAL_RPS=1.0
JIKAN_RPS=1.0
# Para cargas grandes do Jikan, rode uma instância própria (docker run jikanme/jikan-rest) e aponte aqui:
# JIKAN_BASE_URL=http://localhost:8080/v4

# Dias até um registro extraído ser considerado velho e re-extraído
REFRESH_DAYS=7

# Caminho do banco. Use caminho ABSOLUTO se definir (o dbt roda de dentro da pasta dbt/).
# Padrão: <projeto>/data/mal.duckdb
# DUCKDB_PATH=C:\caminho\para\mal-anime-analytics\data\mal.duckdb

# Cópia de consulta para o DBeaver/Power BI (gerada por `malpipe publish`). Pode ficar aberta no
# DBeaver sem travar a ingestão. Padrão: <projeto>/data/mal_reports.duckdb
# REPORTS_DB_PATH=C:\caminho\para\MAL-ANALYTICS\data\mal_reports.duckdb
